\b Appendix A: MATLAB Program Used\b0\line
{\f1\fs20
% AEM 428 Space Propulsion Project 1\line
% Keelan O'Doherty\line
\line
clc;\line
clear;\line
close all;\line
\line
geomFile = 'Mach 3.0.txt';\line
\line
k = 1.4;\line
R = 287;\line
\line
T0_in = 3000;\line
p0_abs = 50e6 + 101325;\line
\line
f_fric = 0.005;\line
qT0 = 30;\line
\line
x0 = 1e-6;\line
M0 = 1 + 1e-4;\line
\line
dx = 1e-4;\line
M2_floor = 1 + 1e-10;\line
max_halves = 20;\line
\line
raw = readmatrix(geomFile);\line
x = raw(:,1);\line
r = raw(:,2);\line
\line
[x,iu] = unique(x,'stable');\line
r = r(iu);\line
x = x - min(x);\line
L = max(x);\line
\line
xg = (0:dx:L).';\line
\line
rg = pchip(x, r, xg);\line
\line
drdx = gradient(rg, xg);\line
d2rdx2 = gradient(drdx, xg);\line
\line
A = pi*rg.^2;\line
dAdx = 2*pi*rg.*drdx;\line
d2Adx2 = 2*pi*(drdx.^2 + rg.*d2rdx2);\line
\line
D = 2*rg;\line
\line
dlnA_dx = dAdx./A;\line
d2lnA_dx2 = (d2Adx2./A) - (dAdx./A).^2;\line
\line
Astar = A(1);\line
mdot = p0_abs*Astar*sqrt(k/(R*T0_in)) * (2/(k+1))^((k+1)/(2*(k-1)));\line
\line
cases = { ...\line
 struct('name','A: isentropic', 'f',0.0, 'q',0.0); ...\line
 struct('name','B: friction', 'f',f_fric, 'q',0.0); ...\line
 struct('name','C: heat', 'f',0.0, 'q',qT0); ...\line
 struct('name','D: both', 'f',f_fric, 'q',qT0) };\line
\line
sol = struct([]);\line
\line
idx0 = find(xg >= x0, 1, 'first');\line
\line
for c = 1:numel(cases)\line
 f = cases{c}.f;\line
 q = cases{c}.q;\line
\line
 T0 = T0_in + q.*xg;\line
\line
 if q == 0\line
 dlnT0_dx = zeros(size(xg));\line
 d2lnT0_dx2 = zeros(size(xg));\line
 else\line
 dlnT0_dx = q ./ T0;\line
 d2lnT0_dx2 = -(q.^2) ./ (T0.^2);\line
 end\line
\line
 S = 4*f ./ D;\line
 dSdx = gradient(S, xg);\line
\line
 M2 = nan(size(xg));\line
 M2(idx0) = M0^2;\line
\line
 for i = idx0:(numel(xg)-1)\line
 Mi2 = M2(i);\line
 if ~isfinite(Mi2)\line
 break\line
 end\line
\line
 dx_local = dx;\line
 ok = false;\line
\line
 for h = 1:max_halves\line
 dM2dx = shapiro_dM2dx_branch(Mi2, k, ...\line
 dlnA_dx(i), dlnT0_dx(i), S(i), ...\line
 d2lnA_dx2(i), d2lnT0_dx2(i), dSdx(i));\line
\line
 M2_try = Mi2 + dM2dx*dx_local;\line
\line
 if M2_try > M2_floor && isfinite(M2_try)\line
 ok = true;\line
 break\line
 else\line
 dx_local = dx_local/2;\line
 end\line
 end\line
\line
 if ~ok\line
 M2(i+1) = Mi2;\line
 else\line
 M2(i+1) = M2_try;\line
 end\line
 end\line
\line
 M = sqrt(M2);\line
\line
 T = T0 ./ (1 + (k-1)/2 .* M.^2);\line
 a = sqrt(k*R*T);\line
 V = M .* a;\line
\line
 rho = mdot ./ (A .* V);\line
 p = rho .* R .* T;\line
\line
 sol(c).name = cases{c}.name;\line
 sol(c).x = xg;\line
 sol(c).M = M;\line
 sol(c).T = T;\line
 sol(c).p = p;\line
end\line
\line
figure(1);\line
clf;\line
grid on;\line
hold on;\line
for i = 1:numel(sol)\line
 plot(sol(i).x, sol(i).M, 'LineWidth', 1.5);\line
end\line
xlabel('x (m)');\line
ylabel('M');\line
title('Mach number vs x (Cases A\endash D)');\line
xline(0,'--');\line
legend({sol.name}, 'Location','best');\line
\line
figure(2);\line
clf;\line
grid on;\line
hold on;\line
for i = 1:numel(sol)\line
 plot(sol(i).x, sol(i).T, 'LineWidth', 1.5);\line
end\line
xlabel('x (m)');\line
ylabel('T (K)');\line
title('Temperature vs x (Cases A\endash D)');\line
xline(0,'--');\line
legend({sol.name}, 'Location','best');\line
\line
figure(3);\line
clf;\line
grid on;\line
hold on;\line
for i = 1:numel(sol)\line
 semilogy(sol(i).x, sol(i).p, 'LineWidth', 1.5);\line
end\line
xlabel('x (m)');\line
ylabel('p (Pa)');\line
title('Pressure vs x (Cases A\endash D)');\line
xline(0,'--');\line
legend({sol.name}, 'Location','best');\line
\line
function dM2dx = shapiro_dM2dx_branch(M2, k, dlnA_dx, dlnT0_dx, S, d2lnA_dx2, d2lnT0_dx2, dSdx)\line
\line
G = M2 * (1 + (k-1)/2 * M2) * ( ...\line
 -2*dlnA_dx ...\line
 + (1 + k*M2)*dlnT0_dx ...\line
 + k*M2*S );\line
\line
denom = (1 - M2);\line
\line
if abs(denom) > 1e-6\line
 dM2dx = G/denom;\line
 return\line
end\line
\line
Phi = (k*(k+1)/2)*dlnT0_dx + (k*(k+1)/2)*S;\line
\line
Psi = -(k+1)*d2lnA_dx2 ...\line
 + ((k+1)^2/2)*d2lnT0_dx2 ...\line
 + (k*(k+1)/2)*dSdx;\line
\line
disc = (Phi/2)^2 - Psi;\line
if disc < 0\line
 disc = 0;\line
end\line
\line
root1 = -Phi/2 + sqrt(disc);\line
root2 = -Phi/2 - sqrt(disc);\line
\line
epsm = 1e-7;\line
M2p = 1 + epsm;\line
Gp = M2p * (1 + (k-1)/2 * M2p) * ( ...\line
 -2*dlnA_dx ...\line
 + (1 + k*M2p)*dlnT0_dx ...\line
 + k*M2p*S );\line
dlim = Gp/(1 - M2p);\line
\line
if abs(root1 - dlim) <= abs(root2 - dlim)\line
 dM2dx = root1;\line
else\line
 dM2dx = root2;\line
end\line
\line
end\line
}\line
